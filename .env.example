# Copy to .env.local and fill in for the features that need it. Local dev works with none of
# these set — see docs/04-ARCHITECTURE.md §6.

# Vercel Blob; auto-injected in prod, needed here for /api/share in dev (P4+).
BLOB_READ_WRITE_TOKEN=

# Absolute origin, used for metadataBase and share URLs — the ONLY place an origin appears
# anywhere in the repo (docs/10-DECISIONS.md D7). Falls back to http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=

# Optional — only if using Vercel KV for card metadata instead of a meta/*.json blob (P4+).
KV_REST_API_URL=
KV_REST_API_TOKEN=
